# Runs only for the explicit `install-user` target. Never remove arbitrary files
# under an OBS profile or example directory.
if(NOT DEFINED PLUGIN_DATA_DIR OR PLUGIN_DATA_DIR STREQUAL "")
    message(FATAL_ERROR "PLUGIN_DATA_DIR is required")
endif()

set(_old "${PLUGIN_DATA_DIR}/examples")
set(_archive "${PLUGIN_DATA_DIR}/legacy-shaderfilter-examples-backup")
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/legacy-example-paths.txt" _manifest)

# Preflight ALL paths before moving any. A previously archived file must never
# be replaced, including one the user may have modified after an earlier run.
foreach(_rel IN LISTS _manifest)
    if(_rel MATCHES "^#" OR _rel STREQUAL "")
        continue()
    endif()
    if(_rel MATCHES "(^/|(^|/)\\.\\.(/|$))")
        message(FATAL_ERROR "Unsafe legacy path: ${_rel}")
    endif()
    set(_src "${_old}/${_rel}")
    set(_dst "${_archive}/${_rel}")
    if(EXISTS "${_src}" OR IS_SYMLINK "${_src}")
        # Never traverse an operator-created symlink into an unrelated tree.
        get_filename_component(_directory "${_src}" DIRECTORY)
        while(NOT _directory STREQUAL "${_old}" AND NOT _directory STREQUAL "${PLUGIN_DATA_DIR}")
            if(IS_SYMLINK "${_directory}")
                message(FATAL_ERROR "Legacy example directory is a symlink: ${_directory}")
            endif()
            get_filename_component(_directory "${_directory}" DIRECTORY)
        endwhile()
        if(IS_SYMLINK "${_old}")
            message(FATAL_ERROR "Legacy examples root is a symlink: ${_old}")
        endif()
        if(EXISTS "${_dst}" OR IS_SYMLINK "${_dst}")
            message(FATAL_ERROR "Legacy shader backup already exists: ${_dst}. Resolve manually; originals have not been moved.")
        endif()
    endif()
endforeach()

foreach(_rel IN LISTS _manifest)
    if(_rel MATCHES "^#" OR _rel STREQUAL "")
        continue()
    endif()
    set(_src "${_old}/${_rel}")
    if(EXISTS "${_src}" OR IS_SYMLINK "${_src}")
        set(_dst "${_archive}/${_rel}")
        get_filename_component(_parent "${_dst}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        file(RENAME "${_src}" "${_dst}")
        message(STATUS "Archived old shader example: ${_rel}")
    endif()
endforeach()
